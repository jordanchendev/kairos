:80 {
  route {
    handle_path /poseidon/* {
      reverse_proxy host.docker.internal:8001 {
        header_up X-API-Key {$POSEIDON_API_KEY}
      }
    }

    # Device-key route (D-09): the browser's own X-API-Key passes through unchanged.
    # Never add header_up X-API-Key here; the legacy key must not carry human authority.
    handle_path /poseidon-auth/* {
      reverse_proxy host.docker.internal:8001
    }

    # Strategy pipeline runner (Poseidon feat/strategy-pipeline, localhost:8011 on this host).
    # KAIROS_PIPELINE_API_KEY is a dedicated principal key (viewer + researcher); it is NOT
    # the legacy Poseidon key. Writes (rerun/abort) need the researcher role.
    handle_path /pipeline/* {
      reverse_proxy host.docker.internal:8011 {
        header_up X-API-Key {$KAIROS_PIPELINE_API_KEY}
      }
    }

    handle_path /triton/* {
      reverse_proxy host.docker.internal:8000
    }

    # Thalassa: read-only through this proxy. The injected key can write upstream, so
    # anything but GET/HEAD is refused here; POST /api/v1/ohlcv/batch is a batch read.
    handle_path /thalassa/* {
      @not_read {
        not method GET HEAD
        not {
          method POST
          path /api/v1/ohlcv/batch
        }
      }
      respond @not_read 405

      reverse_proxy 192.168.31.241:8001 {
        header_up X-API-Key {$THALASSA_API_KEY}
      }
    }

    # Market briefs: read-only brief server on macminim4 (Nexus vault). GET/HEAD only, no key
    # injected. Must stay before the SPA fallback below so an upstream 404/502 reaches the
    # page as an error instead of index.html.
    handle_path /briefs/* {
      @not_read not method GET HEAD
      respond @not_read 405

      # ">" defers the header so it overrides whatever the upstream sends.
      header /index.json >Cache-Control "no-cache"

      reverse_proxy 192.168.31.241:8790
    }

    root * /srv/kairos
    try_files {path} /index.html
    file_server
  }
}
